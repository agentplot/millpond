---
// PLACEHOLDER for the family diagram of @agentplot/site-theme, which draws
// every tool of the family animated, one of them highlighted. Swap this for
// the theme's component, keeping `highlight`, once the theme is published.
interface Props {
  highlight: string;
}
const { highlight } = Astro.props;
const family = [
  ['headwater', 'releases'],
  ['eddy', 'meetings'],
  ['millpond', 'the inbox'],
  ['sluice', 'landing'],
  ['crew', 'teams and plans'],
  ['Flywheel', 'the umbrella'],
];
---

<figure class="family-placeholder not-content" data-placeholder="@agentplot/site-theme family diagram">
  <ul>
    {
      family.map(([name, what]) => (
        <li class:list={{ on: name === highlight }}>
          <strong>{name}</strong>
          <span>{what}</span>
        </li>
      ))
    }
  </ul>
  <figcaption>Placeholder: the family diagram from @agentplot/site-theme goes here, with {highlight} highlighted.</figcaption>
</figure>

<style>
  .family-placeholder {
    margin: 2rem 0;
    padding: 1.25rem;
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: 0.75rem;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    gap: 0.15rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }
  li.on {
    border-color: var(--millpond-accent);
    background: var(--sl-color-accent-low);
  }
  strong {
    font-family: var(--millpond-display);
    color: var(--sl-color-white);
  }
  span,
  figcaption {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  figcaption {
    margin-top: 0.85rem;
  }
</style>
